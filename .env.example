# terraprint project configuration
# Copy this file to .env and edit as needed.

# Root directory for all data (DEMs in, STLs out)
DATA_ROOT=./data

# Your printer profile (set once, used by every make terrain run).
# Profiles live in configs/printers/. Available:
#   configs/printers/kobra3max.json   — Anycubic Kobra 3 Max (400×400mm, 0.4mm nozzle)
# Leave blank to use touchterrain_default.json (250mm tile, 0.4mm nozzle).
# PRINTER=configs/printers/kobra3max.json

# Earth Engine DEM asset to use when fetching via BBOX.
# Valid sources (as of TouchTerrain current release):
#   USGS/3DEP/10m              — 10m, continental US + territories (default)
#   USGS/SRTMGL1_003           — ~30m, near-global coverage (outside the US)
#   USGS/GMTED2010             — ~230m, global
#   NOAA/NGDC/ETOPO1           — ~1800m, global (oceans + land)
#   JAXA/ALOS/AW3D30/V2_2     — 30m, near-global
#   NRCan/CDEM                 — 20m, Canada
#   AU/GA/AUSTRALIA_5M_DEM     — 5m, Australia
#   USGS/GTOPO30               — ~1000m, global
#   MERIT/DEM/v1_0_3           — ~90m, global, hydrologically conditioned
#   CPOM/CryoSat2/ANTARCTICA_DEM — Antarctica
# DEM_SOURCE=USGS/3DEP/10m
